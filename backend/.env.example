PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (fill these in once your project is created)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis server-side cache (Phase A). Same-server redis-server; the app runs
# fully without it (fail-open to Supabase). Set REDIS_ENABLED=0 to force off.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_ENABLED=1

# Gemini API key for the Barangay Map "Explain with AI" feature (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
