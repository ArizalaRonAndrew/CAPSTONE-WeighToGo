PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (fill these in once your project is created)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gemini API key for the Barangay Map "Explain with AI" feature (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
