# Leave blank for local dev (Vite's dev-server proxy in vite.config.js
# handles it) and for production if the frontend is served from the same
# origin as the backend.
#
# Set this only if frontend and backend are deployed to different hosts —
# e.g. https://api.yourdomain.com/api — matching the backend's CLIENT_ORIGIN
# (backend/.env) so CORS + the session cookie both actually work cross-origin.
VITE_API_BASE_URL=
